/-! Smaller-origin meeting families for the shortcut Collatz map.

Core Lean only (no Mathlib).  Contents:
* `affine`: a parity word of length `k` persists under `n + 2^k h`, and `T^k` moves by `3^a h`.
* `Cert.Valid` and `sound`: a finite check at the base values proves the meeting
  `T^k(n0 + N h) = T^l(m0 + M h)` with `0 < m < n` and both parity words, for every `h`.
* `families_valid`: every listed family passes that check (kernel computation).
* `delayed_short`, `delayed_long`: two families with the common partner `m = 717 + 729 h`
  at arbitrarily late source times, for every length `s` of the odd run.
* `even_padding`: prefixing doublings.
* exact integer comparisons used by two analytic arguments.

Nothing here shows that every integer lies in some family, and nothing here proves the Collatz conjecture. -/

namespace CollatzMeet

def T (x : Nat) : Nat := if x % 2 = 0 then x / 2 else (3 * x + 1) / 2

/-- `Tit k x = T^[k] x`. -/
def Tit : Nat → Nat → Nat
  | 0, x => x
  | k + 1, x => Tit k (T x)

/-- Number of odd inputs among the first `k`. -/
def odds : Nat → Nat → Nat
  | 0, _ => 0
  | k + 1, x => x % 2 + odds k (T x)

/-- Parity word of length `k`. -/
def word : Nat → Nat → List Nat
  | 0, _ => []
  | k + 1, x => x % 2 :: word k (T x)

theorem T_shift (x y : Nat) :
    T (x + 2 * y) = T x + 3 ^ (x % 2) * y ∧ (x + 2 * y) % 2 = x % 2 := by
  have hp : (x + 2 * y) % 2 = x % 2 := by omega
  refine ⟨?_, hp⟩
  unfold T
  rcases Nat.mod_two_eq_zero_or_one x with h | h
  · rw [ite_eq_left (by omega : (x + 2 * y) % 2 = 0), ite_eq_left h, h]
    simp
    omega
  · rw [ite_eq_right (by omega : ¬ (x + 2 * y) % 2 = 0), ite_eq_right (by omega : ¬ x % 2 = 0), h]
    simp
    omega

theorem affine : ∀ (k x h : Nat),
    Tit k (x + 2 ^ k * h) = Tit k x + 3 ^ (odds k x) * h ∧ word k (x + 2 ^ k * h) = word k x := by
  intro k
  induction k with
  | zero => intro x h; simp [Tit, odds, word]
  | succ k ih =>
    intro x h
    have e : x + 2 ^ (k + 1) * h = x + 2 * (2 ^ k * h) := by
      rw [Nat.pow_succ, Nat.mul_comm (2 ^ k) 2, Nat.mul_assoc]
    have hT : T (x + 2 * (2 ^ k * h)) = T x + 2 ^ k * (3 ^ (x % 2) * h) := by
      rw [(T_shift x (2 ^ k * h)).1, Nat.mul_left_comm]
    have hp : (x + 2 * (2 ^ k * h)) % 2 = x % 2 := (T_shift x (2 ^ k * h)).2
    obtain ⟨h1, h2⟩ := ih (T x) (3 ^ (x % 2) * h)
    constructor
    · show Tit k (T (x + 2 ^ (k + 1) * h)) = Tit k (T x) + 3 ^ (x % 2 + odds k (T x)) * h
      rw [e, hT, h1, Nat.pow_add, Nat.mul_assoc, Nat.mul_left_comm (3 ^ (x % 2))]
    · show (x + 2 ^ (k + 1) * h) % 2 :: word k (T (x + 2 ^ (k + 1) * h)) = x % 2 :: word k (T x)
      rw [e, hp, hT, h2]

/-- A family `n = n0 + N h`, `m = m0 + M h`, meeting after `k` and `l` steps with words `w`, `v`. -/
structure Cert where
  n0 : Nat
  N : Nat
  m0 : Nat
  M : Nat
  k : Nat
  l : Nat
  w : List Nat
  v : List Nat

def Cert.Valid (c : Cert) : Prop :=
  0 < c.m0 ∧ c.m0 < c.n0 ∧ c.M ≤ c.N ∧ c.N % 2 ^ c.k = 0 ∧ c.M % 2 ^ c.l = 0 ∧
  word c.k c.n0 = c.w ∧ word c.l c.m0 = c.v ∧ Tit c.k c.n0 = Tit c.l c.m0 ∧
  3 ^ (odds c.k c.n0) * (c.N / 2 ^ c.k) = 3 ^ (odds c.l c.m0) * (c.M / 2 ^ c.l)

instance : DecidablePred Cert.Valid := fun c => by unfold Cert.Valid; infer_instance

theorem sound (c : Cert) (hc : c.Valid) (h : Nat) :
    0 < c.m0 + c.M * h ∧ c.m0 + c.M * h < c.n0 + c.N * h ∧
    Tit c.k (c.n0 + c.N * h) = Tit c.l (c.m0 + c.M * h) ∧
    word c.k (c.n0 + c.N * h) = c.w ∧ word c.l (c.m0 + c.M * h) = c.v := by
  obtain ⟨hpos, hlt, hMN, hN, hM, hw, hv, hmeet, hslope⟩ := hc
  have hA : c.N = 2 ^ c.k * (c.N / 2 ^ c.k) := by
    have := Nat.div_add_mod c.N (2 ^ c.k)
    omega
  have hB : c.M = 2 ^ c.l * (c.M / 2 ^ c.l) := by
    have := Nat.div_add_mod c.M (2 ^ c.l)
    omega
  have en : c.n0 + c.N * h = c.n0 + 2 ^ c.k * ((c.N / 2 ^ c.k) * h) := by
    rw [← Nat.mul_assoc, ← hA]
  have em : c.m0 + c.M * h = c.m0 + 2 ^ c.l * ((c.M / 2 ^ c.l) * h) := by
    rw [← Nat.mul_assoc, ← hB]
  have an := affine c.k c.n0 ((c.N / 2 ^ c.k) * h)
  have am := affine c.l c.m0 ((c.M / 2 ^ c.l) * h)
  refine ⟨by omega, Nat.add_lt_add_of_lt_of_le hlt (Nat.mul_le_mul_right h hMN), ?_, ?_, ?_⟩
  · rw [en, em, an.1, am.1, hmeet, ← Nat.mul_assoc, hslope, Nat.mul_assoc]
  · rw [en, an.2, hw]
  · rw [em, am.2, hv]

