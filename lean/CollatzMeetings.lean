def families : List Cert := famTwentyTwo ++ famSixEven ++ famComplements ++ famFiveStep ++ famFixedBase

theorem families_count : families.length = 151 := by decide +kernel

theorem families_valid : ∀ c ∈ families, c.Valid := by decide +kernel

/-- Every listed family is a smaller-origin meeting for every parameter. -/
theorem all_families (c : Cert) (hc : c ∈ families) (h : Nat) :
    0 < c.m0 + c.M * h ∧ c.m0 + c.M * h < c.n0 + c.N * h ∧
    Tit c.k (c.n0 + c.N * h) = Tit c.l (c.m0 + c.M * h) :=
  have s := sound c (families_valid c hc) h
  ⟨s.1, s.2.1, s.2.2.1⟩

theorem Tit_add : ∀ (a b x : Nat), Tit (a + b) x = Tit b (Tit a x) := by
  intro a
  induction a with
  | zero => intro b x; rw [Nat.zero_add]; rfl
  | succ a ih =>
    intro b x
    rw [Nat.succ_add]
    show Tit (a + b) (T x) = Tit b (Tit a (T x))
    exact ih b (T x)

theorem Tit_last (s x : Nat) : Tit (s + 1) x = T (Tit s x) := by
  rw [Tit_add s 1 x]; rfl

theorem T_even (x : Nat) (h : x % 2 = 0) : T x = x / 2 := by
  unfold T; rw [ite_eq_left h]

theorem T_odd (x : Nat) (h : x % 2 = 1) : T x = (3 * x + 1) / 2 := by
  unfold T; rw [ite_eq_right (by omega : ¬ x % 2 = 0)]

/-- Along a run of odd inputs, the pair `(3x+2, x)` is preserved. -/
theorem run3 : ∀ (s x : Nat), (∀ i, i < s → Tit i (3 * x + 2) % 2 = 1) →
    Tit s (3 * x + 2) = 3 * Tit s x + 2 ∧ ∀ i, i < s → Tit i x % 2 = 1 := by
  intro s
  induction s with
  | zero => intro x _; exact ⟨rfl, fun i hi => absurd hi (Nat.not_lt_zero i)⟩
  | succ s ih =>
    intro x H
    have h0 : (3 * x + 2) % 2 = 1 := H 0 (Nat.succ_pos s)
    have hx : x % 2 = 1 := by omega
    have hstep : T (3 * x + 2) = 3 * T x + 2 := by
      rw [T_odd _ h0, T_odd x hx]; omega
    have H' : ∀ i, i < s → Tit i (3 * T x + 2) % 2 = 1 := by
      intro i hi
      rw [← hstep]
      exact H (i + 1) (Nat.succ_lt_succ hi)
    obtain ⟨a, b⟩ := ih (T x) H'
    constructor
    · show Tit s (T (3 * x + 2)) = 3 * Tit s (T x) + 2
      rw [hstep]; exact a
    · intro i hi
      cases i with
      | zero => exact hx
      | succ i => exact b i (Nat.lt_of_succ_lt_succ hi)

/-- The common ten-step prefix: `T^10(1007 + 1024 h) = 3(717 + 729 h) + 2`. -/
theorem prefix10 (h : Nat) : Tit 10 (1007 + 1024 * h) = 3 * (717 + 729 * h) + 2 := by
  have a := (affine 10 1007 h).1
  have e0 : (2 : Nat) ^ 10 = 1024 := by decide
  have e1 : Tit 10 1007 = 2153 := by decide
  have e2 : (3 : Nat) ^ odds 10 1007 = 2187 := by decide
  rw [e0, e1, e2] at a
  omega

/-- Source continuing `1^s 00`: meeting with `m = 717 + 729 h` through target `1^s 01`. -/
theorem delayed_short (h s : Nat)
    (hrun : ∀ i, i < s → Tit i (3 * (717 + 729 * h) + 2) % 2 = 1)
    (h0 : Tit s (3 * (717 + 729 * h) + 2) % 2 = 0)
    (h1 : Tit (s + 1) (3 * (717 + 729 * h) + 2) % 2 = 0) :
    Tit (10 + (s + 2)) (1007 + 1024 * h) = Tit (s + 2) (717 + 729 * h) ∧
    717 + 729 * h < 1007 + 1024 * h ∧
    (∀ i, i < s → Tit i (717 + 729 * h) % 2 = 1) ∧
    Tit s (717 + 729 * h) % 2 = 0 ∧ Tit (s + 1) (717 + 729 * h) % 2 = 1 := by
  obtain ⟨a, b⟩ := run3 s (717 + 729 * h) hrun
  rw [Tit_last] at h1
  rw [a] at h0 h1
  obtain ⟨x, hx⟩ : ∃ x, x = Tit s (717 + 729 * h) := ⟨_, rfl⟩
  rw [← hx] at h0 h1
  rw [T_even _ h0] at h1
  obtain ⟨q, hq⟩ : ∃ q, x = 4 * q + 2 := ⟨x / 4, by omega⟩
  have s1 : T (3 * x + 2) = 6 * q + 4 := by rw [T_even _ h0]; omega
  have s2 : T (6 * q + 4) = 3 * q + 2 := by rw [T_even _ (by omega)]; omega
  have t1 : T x = 2 * q + 1 := by rw [T_even x (by omega)]; omega
  have t2 : T (2 * q + 1) = 3 * q + 2 := by rw [T_odd _ (by omega)]; omega
  refine ⟨?_, by omega, b, by omega, ?_⟩
  · rw [Tit_add 10, prefix10, Tit_add s 2 (3 * (717 + 729 * h) + 2), Tit_add s 2 (717 + 729 * h), a, ← hx]
    show T (T (3 * x + 2)) = T (T x)
    rw [s1, s2, t1, t2]
  · rw [Tit_last, ← hx, t1]; omega

/-- Source continuing `1^s 01000001`: meeting with `m = 717 + 729 h` after `s + 8` further steps. -/
theorem delayed_long (h s : Nat)
    (hrun : ∀ i, i < s → Tit i (3 * (717 + 729 * h) + 2) % 2 = 1)
    (h0 : Tit s (3 * (717 + 729 * h) + 2) % 2 = 0)
    (h1 : Tit (s + 1) (3 * (717 + 729 * h) + 2) % 2 = 1)
    (h2 : Tit (s + 2) (3 * (717 + 729 * h) + 2) % 64 = 32) :
    Tit (10 + (s + 8)) (1007 + 1024 * h) = Tit (s + 8) (717 + 729 * h) ∧
    717 + 729 * h < 1007 + 1024 * h := by
  obtain ⟨a, _⟩ := run3 s (717 + 729 * h) hrun
  rw [Tit_last] at h1
  rw [Tit_add s 2] at h2
  rw [a] at h0 h1 h2
  obtain ⟨x, hx⟩ : ∃ x, x = Tit s (717 + 729 * h) := ⟨_, rfl⟩
  rw [← hx] at h0 h1 h2
  rw [T_even _ h0] at h1
  obtain ⟨z, hz⟩ : ∃ z, x = 4 * z := ⟨x / 4, by omega⟩
  have s1 : T (3 * x + 2) = 6 * z + 1 := by rw [T_even _ h0]; omega
  have s2 : T (6 * z + 1) = 9 * z + 2 := by rw [T_odd _ (by omega)]; omega
  have t1 : T x = 2 * z := by rw [T_even x (by omega)]; omega
  have t2 : T (2 * z) = z := by rw [T_even _ (by omega)]; omega
  have hs : Tit 2 (3 * x + 2) = 9 * z + 2 := by
    show T (T (3 * x + 2)) = 9 * z + 2
    rw [s1, s2]
  have ht : Tit 2 x = z := by
    show T (T x) = z
    rw [t1, t2]
  rw [hs] at h2
  obtain ⟨r, hr⟩ : ∃ r, z = 46 + 64 * r := ⟨z / 64, by omega⟩
  have e0 : (2 : Nat) ^ 6 = 64 := by decide
  have sa : Tit 6 (9 * z + 2) = 20 + 27 * r := by
    have hh := (affine 6 416 (9 * r)).1
    have e1 : Tit 6 416 = 20 := by decide
    have e2 : (3 : Nat) ^ odds 6 416 = 3 := by decide
    rw [e0, e1, e2] at hh
    have e : 9 * z + 2 = 416 + 64 * (9 * r) := by omega
    rw [e, hh]; omega
  have ta : Tit 6 z = 20 + 27 * r := by
    have hh := (affine 6 46 r).1
    have e1 : Tit 6 46 = 20 := by decide
    have e2 : (3 : Nat) ^ odds 6 46 = 27 := by decide
    rw [e0, e1, e2] at hh
    rw [hr]; exact hh
  refine ⟨?_, by omega⟩
  rw [Tit_add 10, prefix10, Tit_add s 8 (3 * (717 + 729 * h) + 2), Tit_add s 8 (717 + 729 * h), a, ← hx]
  rw [Tit_add 2 6 (3 * x + 2), Tit_add 2 6 x, hs, ht, sa, ta]

/-- Prefixing `e` doublings: `2^e x` reaches `x` after `e` even steps. -/
theorem even_padding : ∀ (e x : Nat), Tit e (2 ^ e * x) = x := by
  intro e
  induction e with
  | zero => intro x; simp [Tit]
  | succ e ih =>
    intro x
    have h1 : 2 ^ (e + 1) * x = 2 * (2 ^ e * x) := by
      rw [Nat.pow_succ, Nat.mul_comm (2 ^ e) 2, Nat.mul_assoc]
    show Tit e (T (2 ^ (e + 1) * x)) = x
    rw [h1, T_even _ (by omega), Nat.mul_div_cancel_left _ (by omega : 0 < 2)]
    exact ih x

/-- Integer comparisons used for a ternary cover estimate. -/
theorem cover_comparisons :
    3 ^ 17 < 2 ^ 27 ∧ 8 ^ 27 * 100 ^ 17 < 3 ^ 27 * 5 ^ 17 * 97 ^ 17 ∧
    10 * 97 ^ 76 < 100 ^ 76 ∧ 6189245291 / 76 = 81437438 := by
  decide +kernel

/-- The unimodular pair and the resulting odd-count bound in a logarithmic strip argument. -/
theorem strip_determinant :
    630138897 * 225644606 = 357638239 * 397573379 + 1 ∧
    357638239 + 15 * 630138897 = 9809721694 ∧ 225644606 + 15 * 397573379 = 6189245291 := by
  decide

theorem strip_count (x z : Nat) (hx : 1 ≤ x) (hz : 15 * x ≤ z) :
    6189245291 ≤ x * 225644606 + z * 397573379 := by
  omega

